# Vercel Environment Variables
# Copy this file to .env.local for local development with `vercel dev`
# DO NOT commit .env.local to git.

# Your Telegram Bot Token
TG_BOT_TOKEN=your_bot_token_here

# Your Telegram channel username (with or without @)
TG_CHANNEL=@tochilka_online

# PocketBase settings
POCKETBASE_URL=https://api.tochilka.app

# Database Admin Credentials (used in setup scripts)
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# Demo Seeding Credentials
DEMO_EMAIL=
DEMO_PASSWORD=

# Test Credentials
TEST_EMAIL=
TEST_PASSWORD=

# Yookassa Payment API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
